# ── Database ─────────────────────────────────────────────────────────────
# Matches docker-compose.yml. The port is 5434 rather than the Postgres default
# so it does not collide with a Postgres you may already be running locally.
# If 5434 is taken too, change it here AND in docker-compose.yml — they must agree.
DATABASE_URL=postgres://transpay:transpay@localhost:5434/transpay

# ── Stellar ──────────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Asset used for the settlement leg. The testnet issuer is NOT fixed the way it
# is on mainnet — run `pnpm stellar:bootstrap` to create the issuer plus the two
# corridor accounts, then paste the values it prints here. The README must state
# which issuer is in use.
STELLAR_ASSET_CODE=USDC
STELLAR_USDC_ISSUER=

# Corridor accounts. TESTNET ONLY — never put a mainnet key here.
CORRIDOR_TREASURY_SECRET=      # USD-side treasury, the source of the settlement leg
CORRIDOR_PAYOUT_PUBLIC=        # PHP-side payout float, the destination

# ── Worker ───────────────────────────────────────────────────────────────
SETTLEMENT_POLL_INTERVAL_MS=3000
SETTLEMENT_TIMEBOUNDS_SEC=180

# ── Evidence scripts ─────────────────────────────────────────────────────
# Where `pnpm evidence:d1` sends the chat-flow HTTP requests. The app itself
# never reads this — set it only to point a run at a deployed instance.
EVIDENCE_BASE_URL=http://localhost:3000
